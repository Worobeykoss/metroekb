<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тёмная тема без ActionBar. Внешний вид UI задаёт Compose (Material3);
         этой теме достаточно тёмного фона и статус-бара, чтобы не мигать белым при старте. -->
    <style name="Theme.MetroEkb" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:colorPrimary">@color/line_red</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
